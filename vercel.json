{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend/dist"
      }
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "excludeFiles": "{frontend/**,node_modules/**,docs/**,.venv/**}"
      }
    }
  ],
  "routes": [
    {
      "src": "/api(?:/.*)?",
      "dest": "/api/index.py"
    },
    {
      "src": "/media(?:/.*)?",
      "dest": "/api/index.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/assets(?:/.*)?",
      "status": 404
    },
    {
      "src": "/.*\\.[^/]+$",
      "status": 404
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
