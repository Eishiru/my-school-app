{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend/dist"
      }
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 30,
        "memory": 1024,
        "excludeFiles": "{frontend/**,frontend/node_modules/**,docs/**,.venv/**,backend/media/**,backend/dist/**,**/*.sqlite3,**/*.pyc,**/__pycache__/**}"
      }
    }
  ],
  "routes": [
    {
      "src": "/api(?:/.*)?",
      "dest": "/api/index.py"
    },
    {
      "src": "/media(?:/.*)?",
      "dest": "/api/index.py"
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/(.*\\.(?:ico|png|jpg|jpeg|svg|webp|woff|woff2|ttf))$",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/index\\.html$",
      "headers": {
        "cache-control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/assets(?:/.*)?",
      "status": 404
    },
    {
      "src": "/.*\\.[^/]+$",
      "status": 404
    },
    {
      "src": "/.*",
      "headers": {
        "cache-control": "public, max-age=0, must-revalidate"
      },
      "dest": "/index.html"
    }
  ]
}
